# Copy to .env, fill real values, then run: chmod 600 .env
# Validate without exposing values: npm run preflight -- --target ingest:send

# ---- DeepSeek (排名 / 总结 / 影响；OpenAI 兼容协议) ----
DEEPSEEK_API_KEY=sk-...

# ---- Supabase (共享数据库；本地任务与 Web 服务端使用) ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_... # 仅 server-side，绝不得使用 NEXT_PUBLIC_

# ---- Server酱 (每晚推送到微信) ----
# 去 https://sct.ftqq.com 用微信扫码登录、关注服务号，复制 SendKey 填这里。
# 兼容老版 Turbo(SCT...) 与 Server酱³(sctp...) 两种 key，代码自动适配。
SERVERCHAN_SENDKEY=SCT...

# ---- 可选 SMTP 邮件推送（配置以下 7 项后与微信双通道发送） ----
# 163 邮箱示例收件人：hgjly1206@163.com；SMTP_PASS 使用授权码，不是登录密码。
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-sender@163.com
# SMTP_PASS=your-smtp-app-password
# EMAIL_FROM=your-sender@163.com
# EMAIL_TO=hgjly1206@163.com

# ---- 可选：抬高 github 未鉴权速率限制 ----
GITHUB_TOKEN=

# ---- OpenAlex：配置校验可选，稳定采集强烈建议填写官方免费 API key ----
# 未填写时不会阻断其他来源，但 OpenAlex 匿名访问可能单独降级。
OPENALEX_API_KEY=

# ---- owner 登录后确认的一次性反馈链接（ingest / ingest:send / push:last 必需）----
# 仅填 origin：本地可用 http://127.0.0.1:3000，生产使用最终 HTTPS origin。
WEB_BASE_URL=
# 至少 32 字节；可用 openssl rand -hex 32 生成。
FEEDBACK_SECRET=

# ---- 独立失败告警 webhook（不依赖微信/SMTP 投递通道） ----
# 手工运行时可不配；npm run doctor、launchd 安装和云任务要求配置 URL。
# URL 必须是 HTTPS；bearer token 可选。告警失败不会覆盖原始任务错误。
# URL 也可能含密钥，URL/token 均不得使用 NEXT_PUBLIC_、VITE_ 等公开前缀。
# ALERT_WEBHOOK_URL=https://alerts.example.com/frontier
# ALERT_WEBHOOK_TOKEN=replace-with-alert-token
