<?xml version="1.0" encoding="UTF-8"?>
<!-- 模板由 scripts/install-cron.sh 写入绝对路径并加载，请勿手工复制。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.frontierpapers.refine</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_DIR__/scripts/run-scheduled.sh</string>
    <string>refine</string>
    <string>__NODE_PATH__</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>23</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- Retry an unsuccessful due schedule; a successful schedule token makes each wake a cheap no-op. -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <!-- The runner de-duplicates this startup catch-up against its last successful schedule token. -->
  <key>RunAtLoad</key>
  <true/>

  <key>Umask</key>
  <integer>63</integer>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/refine.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/refine.log</string>
</dict>
</plist>
