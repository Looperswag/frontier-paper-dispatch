<?xml version="1.0" encoding="UTF-8"?>
<!-- 模板由 scripts/install-cron.sh 写入绝对路径并加载，请勿手工复制。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.frontierpapers.deliver</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_DIR__/scripts/run-scheduled.sh</string>
    <string>deliver</string>
    <string>__NODE_PATH__</string>
  </array>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>Umask</key>
  <integer>63</integer>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/delivery.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/delivery.log</string>
</dict>
</plist>
