# Supabase server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Exact, pre-created and email-confirmed Supabase Auth owner account.
# The owner's real password belongs only in a password manager/browser form;
# never add it to this file or to Vercel environment variables.
AUTH_OWNER_EMAIL=

DEEPSEEK_API_KEY=sk-...

# Owner-only confirmation links. Keep both values identical to the root env.
# WEB_BASE_URL is an origin only: http://127.0.0.1:3000 locally, final HTTPS in production.
WEB_BASE_URL=
# At least 32 bytes; generate with: openssl rand -hex 32
FEEDBACK_SECRET=

# Distributed API throttling uses only an HMAC of the trusted client IP.
# Keep the version stable until intentionally rotating the secret.
# Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=
RATE_LIMIT_SECRET_VERSION=1
